local Categories = {}
local ActiveCategory = nil

local function CreateCategory(name, order)
    local Btn = Instance.new("TextButton")
    Btn.Size = UDim2.new(1,0,0,40)
    Btn.BackgroundColor3 = Color3.fromRGB(10,10,10)
    Btn.BackgroundTransparency = 0.2
    Btn.Text = "  "..name
    Btn.TextColor3 = Color3.fromRGB(120,120,120)
    Btn.TextScaled = true
    Btn.Font = Enum.Font.GothamBold
    Btn.TextXAlignment = Enum.TextXAlignment.Left
    Btn.BorderSizePixel = 0
    Btn.LayoutOrder = order
    Btn.ZIndex = 13
    Btn.Parent = CatList
    Instance.new("UICorner", Btn).CornerRadius = UDim.new(0,8)

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(40,40,40)
    BtnStroke.Thickness = 1
    BtnStroke.Parent = Btn

    -- Container page (ScrollingFrame with explicit canvas)
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1,0,1,0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 3
    Page.ScrollBarImageColor3 = Color3.fromRGB(90,90,90)
    Page.Visible = false
    Page.ZIndex = 12
    Page.CanvasSize = UDim2.new(0,0,0,0)
    Page.Parent = ContentArea

    local PL = Instance.new("UIListLayout")
    PL.SortOrder = Enum.SortOrder.LayoutOrder
    PL.Padding = UDim.new(0,6)
    PL.Parent = Page

    local PP = Instance.new("UIPadding")
    PP.PaddingLeft = UDim.new(0,15)
    PP.PaddingTop = UDim.new(0,8)
    PP.PaddingRight = UDim.new(0,15)
    PP.PaddingBottom = UDim.new(0,15)
    PP.Parent = Page

    -- Force canvas update on children change
    local function UpdateCanvas()
        Page.CanvasSize = UDim2.new(0,0,0,PL.AbsoluteContentSize.Y + 25)
    end
    PL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
    task.spawn(function()
        while Page.Parent do
            UpdateCanvas()
            task.wait(0.25)
        end
    end)

    Btn.MouseButton1Click:Connect(function()
        if ActiveCategory then
            Categories[ActiveCategory].Page.Visible = false
            Categories[ActiveCategory].Btn.BackgroundColor3 = Color3.fromRGB(10,10,10)
            Categories[ActiveCategory].Btn.TextColor3 = Color3.fromRGB(120,120,120)
            Categories[ActiveCategory].Stroke.Color = Color3.fromRGB(40,40,40)
        end
        ActiveCategory = name
        Page.Visible = true
        Btn.BackgroundColor3 = Color3.fromRGB(28,28,28)
        Btn.TextColor3 = Color3.fromRGB(255,255,255)
        BtnStroke.Color = Color3.fromRGB(100,100,100)
        PageTitle.Text = string.upper(name)
        UpdateCanvas()
    end)

    Categories[name] = {Btn=Btn, Page=Page, Stroke=BtnStroke, UpdateCanvas=UpdateCanvas}
    return Page
end


local function GetClosestPlayer(fov, partName)
    local closest,closestDist=nil,math.huge
    local center=Vector2.new(Camera.ViewportSize.X/2,Camera.ViewportSize.Y/2)
    for _,player in pairs(Players:GetPlayers()) do
        if player==LocalPlayer then continue end
        if State.ESPTeamCheck and player.Team==LocalPlayer.Team then continue end
        local char=player.Character; local part=char and char:FindFirstChild(partName or State.AimPart)
        if not part then continue end
        local screen,vis=Camera:WorldToViewportPoint(part.Position)
        if not vis then continue end
        local dist=(Vector2.new(screen.X,screen.Y)-center).Magnitude
        if dist<fov and dist<closestDist then closest=part; closestDist=dist end
    end
    return closest
end

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if State.SilentAim and (method == "FireServer" or method == "InvokeServer") then
        local args = {...}
        for i,v in pairs(args) do
            if typeof(v) == "Vector3" or typeof(v) == "CFrame" then
                local target = GetClosestPlayer(State.SilentAimFOV, State.AimPart)
                if target then
                    if typeof(v) == "Vector3" then args[i] = target.Position
                    elseif typeof(v) == "CFrame" then args[i] = CFrame.new(Camera.CFrame.Position, target.Position) end
                end
            end
        end
        return oldNamecall(self, table.unpack(args))
    end
    return oldNamecall(self, ...)
end)

local mt = getrawmetatable(game)
local oldIndex = mt.__index
setreadonly(mt, false)
mt.__index = newcclosure(function(self, key)
    if State.WallBang and (key == "Raycast" or key == "FindPartOnRay" or key == "FindPartOnRayWithIgnoreList") then
        return function(_, ...)
            local args = {...}
            local rp = RaycastParams.new()
            rp.FilterType = Enum.RaycastFilterType.Exclude
            rp.FilterDescendantsInstances = {}
            if typeof(args[1]) == "Ray" then
                return oldIndex(self, key)(_, Ray.new(args[1].Origin, args[1].Direction), rp)
            end
            return oldIndex(self, key)(_, ...)
        end
    end
    if State.MagicBullet and (key == "Raycast" or key == "FindPartOnRay" or key == "FindPartOnRayWithIgnoreList") then
        return function(_, ...)
            local targets = {}
            for _,p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local t = p.Character:FindFirstChild(State.AimPart)
                    if t then table.insert(targets, t) end
                end
            end
            if #targets > 0 then
                local target = targets[math.random(1,#targets)]
                local args = {...}
                if typeof(args[1]) == "Ray" then args[1] = Ray.new(args[1].Origin, (target.Position - args[1].Origin))
                elseif typeof(args[1]) == "Vector3" then args[2] = (target.Position - args[1]) end
                return oldIndex(self, key)(_, table.unpack(args))
            end
            return oldIndex(self, key)(_, ...)
        end
    end
    return oldIndex(self, key)
end)
setreadonly(mt, true)

